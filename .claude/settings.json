{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_fable_review.mjs\"",
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "Checking for a Fable code review of this commit"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_fable_review.mjs\"",
            "timeout": 30,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
