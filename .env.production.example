# Copy to .env.production on the server and fill in. Never commit the real file.

# Public domain (Caddy issues the HTTPS certificate for it)
DOMAIN=dripnepal.com

TZ=UTC
NODE_ENV=production
# production needs the managed PostgreSQL of docs/11 §1 with TLS (DB_SSL=true).
# The Postgres container of docker-compose.prod.yml serves no TLS, so this
# stack runs as staging until that database exists (start/env_policy.ts).
APP_ENV=staging
APP_NAME=dripnepal
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# Generate with: docker compose -f docker-compose.prod.yml run --rm --no-deps app node ace generate:key --show
APP_KEY=
# Set only for the 7 days of a yearly key rotation (docs/07 §5.5)
APP_KEY_PREVIOUS=
APP_URL=https://dripnepal.com

SESSION_DRIVER=database
LIMITER_STORE=database

# The Compose network Caddy and the app share (docker-compose.prod.yml). Add
# Cloudflare's published ranges here if you put Cloudflare in front.
TRUSTED_PROXY_CIDRS=172.30.0.0/24
DRIVE_DISK=fs

# Postgres (the compose file points the app at the "postgres" service)
DB_USER=dripnepal
DB_PASSWORD=change-me-to-a-long-random-password
DB_DATABASE=dripnepal
# true with the managed database, plus its CA certificate (PEM) in DB_SSL_CA
DB_SSL=false
DB_SSL_CA=
DB_POOL_MAX=8

VITE_APP_NAME="Drip Nepal"

# Outgoing email over SMTP (config/mail.ts). No code sends email yet: the flows
# rebuilt from M1 add it (docs/12).
# Port 465 uses TLS from the start; on other ports (587) the connection switches
# to TLS with STARTTLS when the server offers it.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="Drip Nepal <you@gmail.com>"


# How customers reach the store, shared with every page (config/storefront.ts).
# The phone number also becomes a WhatsApp link. Unset ones are hidden.
SUPPORT_PHONE=
SUPPORT_EMAIL=
# INSTAGRAM_URL=https://instagram.com/your-shop
# FACEBOOK_URL=https://facebook.com/your-shop
# TIKTOK_URL=https://tiktok.com/@your-shop

# The running release: the image build sets APP_RELEASE from the build argument
# (docker-compose.prod.yml passes the APP_RELEASE of the shell or this file).
APP_RELEASE=

# Keys of docs/07 §5.5: each one different, each generated with
#   openssl rand -base64 32
# The key ring is <id>:<key>; DATA_ENCRYPTION_ACTIVE_KEY_ID names the key that encrypts.
DATA_ENCRYPTION_KEYS=
DATA_ENCRYPTION_ACTIVE_KEY_ID=
BLIND_INDEX_KEY=
HMAC_KEY_LIMITER=
HMAC_KEY_AUDIT_IP=
HMAC_KEY_NOTIFY_ADDRESS=
# The error tracker: set both together, once the tracker is provisioned (docs/09 §5.6)
HMAC_KEY_TELEMETRY=
SENTRY_DSN=
