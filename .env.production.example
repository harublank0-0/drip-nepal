# Copy to .env.production on the server and fill in. Never commit the real file.

# Public domain (Caddy issues the HTTPS certificate for it)
DOMAIN=dripnepal.com

TZ=UTC
NODE_ENV=production
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# Generate with: docker compose -f docker-compose.prod.yml run --rm --no-deps app node ace generate:key --show
APP_KEY=
APP_URL=https://dripnepal.com

SESSION_DRIVER=database
LIMITER_STORE=database

# The Compose network Caddy and the app share (docker-compose.prod.yml). Add
# Cloudflare's published ranges here if you put Cloudflare in front.
TRUSTED_PROXY_CIDRS=172.30.0.0/24
DRIVE_DISK=fs

# Postgres (the compose file points the app at the "postgres" service)
DB_USER=dripnepal
DB_PASSWORD=change-me-to-a-long-random-password
DB_DATABASE=dripnepal

VITE_APP_NAME="Drip Nepal"

# One seller in v1: keep closed except while registering your own shop (DEPLOY.md step 4)
SHOP_REGISTRATION_OPEN=false

# How customers reach you (footer, order pages, policies, "Forgot password?").
# The phone number also becomes a WhatsApp link. Unset ones are hidden.
SUPPORT_PHONE=
SUPPORT_EMAIL=
# INSTAGRAM_URL=https://instagram.com/your-shop
# FACEBOOK_URL=https://facebook.com/your-shop
# TIKTOK_URL=https://tiktok.com/@your-shop

# Optional: the running release, shown by /health/live (for example the git commit)
# APP_RELEASE=
