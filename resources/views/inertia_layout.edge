<!DOCTYPE html>
{{-- The theme class comes from the dn_theme cookie, shared as page.props.theme
     (docs/08 §1.2, docs/09 §13.10), so the first paint is already right (RF-08). --}}
@let(theme = page.props.theme)
<html lang="en" class="{{ theme === 'system' ? '' : theme === 'dark' ? 'dark' : 'light' }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {{-- The browser chrome follows the theme: THEME_COLORS of shared/ui/theme.ts. --}}
    @if(theme === 'system')
      <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
      <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    @else
      <meta name="theme-color" content="{{ theme === 'dark' ? '#09090b' : '#ffffff' }}" />
    @end
    @if(theme === 'system')
      {{-- The server cannot know the system theme: set it before first paint. --}}
      <script nonce="{{ cspNonce ?? '' }}">document.documentElement.classList.add(matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')</script>
    @end
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {{-- The refresh preamble is inline: written where the Vite dev server runs,
         `node ace test` included, where CSP is on (docs/07 §7.3). --}}
    @viteReactRefresh({ nonce: cspNonce })
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>

</html>
