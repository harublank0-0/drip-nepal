{{--
  identity.sessions_revoked, the HTML part (docs/09 §11.2): the notice to
  the holder of an account whose sessions were signed out, by "Sign out of
  all devices" (revokeAllSessions) or after the 10th wrong password while
  signed in (01 AC-FR-NOT-001-1). It carries no token, only a link to the
  reset request page, for a holder who did not do it. Every value is
  printed escaped. Values: `t`, `link`.
--}}
@component('emails/layouts/html', {
  t: t,
  title: t('emails.identity.sessions_revoked.subject'),
})
  <p style="margin: 0 0 16px;">{{ t('emails.identity.sessions_revoked.intro') }}</p>
  <p style="margin: 0 0 16px;">{{ t('emails.identity.sessions_revoked.why') }}</p>
  <p style="margin: 0 0 16px;">{{ t('emails.identity.sessions_revoked.yours') }}</p>
  <p style="margin: 0 0 16px;">{{ t('emails.identity.sessions_revoked.not_yours') }}</p>
  <p style="margin: 0 0 16px;">
    <a
      href="{{ link }}"
      style="display: inline-block; padding: 12px 20px; border-radius: 6px; background-color: #18181b; color: #ffffff; font-weight: bold; text-decoration: none;"
    >
      {{ t('emails.identity.sessions_revoked.action') }}
    </a>
  </p>
  <p style="margin: 0; color: #52525b; font-size: 14px; word-break: break-all;">
    {{ t('emails.identity.sessions_revoked.link_hint') }}
    <br />
    {{ link }}
  </p>
@end
