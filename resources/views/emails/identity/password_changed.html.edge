{{--
  identity.password_changed, the HTML part (docs/09 §11.2): the notice to
  the holder of an account whose password was reset or changed (02
  AC-J18-06, 01 AC-FR-IAM-004-4, AC-FR-IAM-005-4). It carries no token, only
  a link to the reset request page, for a holder who did not make the
  change. Every value is printed escaped. Values: `t`, `link`.
--}}
@component('emails/layouts/html', {
  t: t,
  title: t('emails.identity.password_changed.subject'),
})
  <p style="margin: 0 0 16px;">{{ t('emails.identity.password_changed.intro') }}</p>
  <p style="margin: 0 0 16px;">{{ t('emails.identity.password_changed.sessions') }}</p>
  <p style="margin: 0 0 16px;">{{ t('emails.identity.password_changed.yours') }}</p>
  <p style="margin: 0 0 16px;">{{ t('emails.identity.password_changed.not_yours') }}</p>
  <p style="margin: 0 0 16px;">
    <a
      href="{{ link }}"
      style="display: inline-block; padding: 12px 20px; border-radius: 6px; background-color: #18181b; color: #ffffff; font-weight: bold; text-decoration: none;"
    >
      {{ t('emails.identity.password_changed.action') }}
    </a>
  </p>
  <p style="margin: 0; color: #52525b; font-size: 14px; word-break: break-all;">
    {{ t('emails.identity.password_changed.link_hint') }}
    <br />
    {{ link }}
  </p>
@end
