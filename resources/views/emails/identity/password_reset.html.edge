{{--
  identity.password_reset, the HTML part (docs/09 §11.2): a password_reset
  token's link, which also delivers the invitation of platform:create-admin
  (docs/09 §9.1). Every value is printed escaped. Values: `t`, `link`,
  `minutes`.
--}}
@component('emails/layouts/html', {
  t: t,
  title: t('emails.identity.password_reset.subject'),
})
  <p style="margin: 0 0 16px;">{{ t('emails.identity.password_reset.intro') }}</p>
  <p style="margin: 0 0 16px;">
    <a
      href="{{ link }}"
      style="display: inline-block; padding: 12px 20px; border-radius: 6px; background-color: #18181b; color: #ffffff; font-weight: bold; text-decoration: none;"
    >
      {{ t('emails.identity.password_reset.action') }}
    </a>
  </p>
  <p style="margin: 0 0 16px; color: #52525b; font-size: 14px; word-break: break-all;">
    {{ t('emails.identity.password_reset.link_hint') }}
    <br />
    {{ link }}
  </p>
  <p style="margin: 0 0 16px;">
    {{ t('emails.identity.password_reset.expiry', { minutes: minutes }) }}
  </p>
  <p style="margin: 0;">{{ t('emails.identity.password_reset.ignore') }}</p>
@end
