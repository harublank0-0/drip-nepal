{{--
  identity.account_exists, the HTML part (docs/09 §11.2): the notice to the
  holder of an email someone tried to sign up with (01 AC-FR-IAM-001-2),
  sent instead of a verification email. It carries no token, only a link to
  the sign-in page. Every value is printed escaped. Values: `t`, `link`.
--}}
@component('emails/layouts/html', {
  t: t,
  title: t('emails.identity.account_exists.subject'),
})
  <p style="margin: 0 0 16px;">{{ t('emails.identity.account_exists.intro') }}</p>
  <p style="margin: 0 0 16px;">
    <a
      href="{{ link }}"
      style="display: inline-block; padding: 12px 20px; border-radius: 6px; background-color: #18181b; color: #ffffff; font-weight: bold; text-decoration: none;"
    >
      {{ t('emails.identity.account_exists.action') }}
    </a>
  </p>
  <p style="margin: 0 0 16px; color: #52525b; font-size: 14px; word-break: break-all;">
    {{ t('emails.identity.account_exists.link_hint') }}
    <br />
    {{ link }}
  </p>
  <p style="margin: 0 0 16px;">{{ t('emails.identity.account_exists.forgot') }}</p>
  <p style="margin: 0;">{{ t('emails.identity.account_exists.ignore') }}</p>
@end
