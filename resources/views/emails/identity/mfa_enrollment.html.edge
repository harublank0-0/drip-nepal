{{--
  identity.mfa_enrollment, the HTML part (docs/09 §11.2): an mfa_enrollment
  token's link to the TOTP enrolment page (docs/07 §3.9). Every value is
  printed escaped. Values: `t`, `link`, `hours`.
--}}
@component('emails/layouts/html', {
  t: t,
  title: t('emails.identity.mfa_enrollment.subject'),
})
  <p style="margin: 0 0 16px;">{{ t('emails.identity.mfa_enrollment.intro') }}</p>
  <p style="margin: 0 0 16px;">
    <a
      href="{{ link }}"
      style="display: inline-block; padding: 12px 20px; border-radius: 6px; background-color: #18181b; color: #ffffff; font-weight: bold; text-decoration: none;"
    >
      {{ t('emails.identity.mfa_enrollment.action') }}
    </a>
  </p>
  <p style="margin: 0 0 16px; color: #52525b; font-size: 14px; word-break: break-all;">
    {{ t('emails.identity.mfa_enrollment.link_hint') }}
    <br />
    {{ link }}
  </p>
  <p style="margin: 0 0 16px;">
    {{ t('emails.identity.mfa_enrollment.expiry', { hours: hours }) }}
  </p>
  <p style="margin: 0;">{{ t('emails.identity.mfa_enrollment.ignore') }}</p>
@end
