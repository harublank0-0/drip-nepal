{{--
  The HTML frame of every email (docs/09 §11.2, docs/07 TM-11). A reviewed
  static layout: it prints its main slot raw, because the slot is the
  already escaped output of the email's own HTML template. Every other value
  is escaped. Props: `t`, the email catalog, and `title`. No images, so it
  reads the same with images blocked (AC-FR-NOT-001-3); styles are inline,
  because mail clients drop style blocks.
--}}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}</title>
  </head>
  <body
    style="margin: 0; padding: 24px 16px; background-color: #ffffff; color: #18181b; font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.5;"
  >
    <div style="max-width: 560px; margin: 0 auto;">
      <p style="margin: 0 0 24px; font-size: 20px; font-weight: bold;">
        {{ t('emails.layout.brand') }}
      </p>
      {{{ await $slots.main() }}}
      <p style="margin: 32px 0 0; color: #52525b; font-size: 13px;">
        {{ t('emails.layout.footer') }}
      </p>
    </div>
  </body>
</html>
