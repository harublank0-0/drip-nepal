# Test overrides, loaded before .env when NODE_ENV=test (docs/09 §6.4).
# The first file that sets a key wins, so every key whose test value must
# differ from development is set here. start/env.ts refuses a database name
# without the _test suffix (RF-32).
NODE_ENV=test
SESSION_DRIVER=memory
DB_DATABASE=dripnepal_test
# Two roles, as in production (docs/10 §3.2, docs/07 §4.10): tests run as
# dripnepal_app, and the run's setup migrates as dripnepal_migrator on the
# pg_migrator connection. DB_PASSWORD comes from .env; the roles are created
# by docker/postgres/init/ with the docker-compose password.
DB_USER=dripnepal_app
DB_MIGRATOR_USER=dripnepal_migrator
DB_MIGRATOR_PASSWORD=secret
# No real email from tests, even when .env points at Mailpit.
SMTP_HOST=
