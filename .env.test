# Test overrides, loaded before .env when NODE_ENV=test (docs/09 §6.4).
# The first file that sets a key wins, so every key whose test value must
# differ from development is set here. start/env.ts refuses a database name
# without the _test suffix (RF-32).
NODE_ENV=test
APP_ENV=test
APP_NAME=dripnepal-test
LOG_LEVEL=warn
# A fixed test value; CI replaces it with a throwaway key per run.
APP_KEY=dripnepal-test-only-app-key-not-a-secret
# The stores production uses: session tests read and delete `sessions` rows
# (docs/07 §3.1), and the limiter tests read `rate_limits` (docs/04a §15.4).
SESSION_DRIVER=database
LIMITER_STORE=database
DB_DATABASE=dripnepal_test
# Two roles, as in production (docs/10 §3.2, docs/07 §4.10): tests run as
# dripnepal_app, and the run's setup migrates as dripnepal_migrator on the
# pg_migrator connection. DB_PASSWORD comes from .env; the roles are created
# by docker/postgres/init/ with `secret`, the .env.example default of DB_PASSWORD.
DB_USER=dripnepal_app
DB_MIGRATOR_USER=dripnepal_migrator
DB_MIGRATOR_PASSWORD=secret
DB_SSL=false
# The concurrency suite opens parallel connections (docs/10 §3.3).
DB_POOL_MAX=20
# Fixed test keys (docs/09 §6.1): readable placeholders, never real keys.
DATA_ENCRYPTION_KEYS=test1:ZHJpcG5lcGFsIHRlc3QgcmluZyAxLi4uLi4uLi4uLi4=
DATA_ENCRYPTION_ACTIVE_KEY_ID=test1
BLIND_INDEX_KEY=ZHJpcG5lcGFsIHRlc3QgYmxpbmQgaW5kZXguLi4uLi4=
HMAC_KEY_LIMITER=ZHJpcG5lcGFsIHRlc3QgaG1hYyBsaW1pdGVyLi4uLi4=
HMAC_KEY_AUDIT_IP=ZHJpcG5lcGFsIHRlc3QgaG1hYyBhdWRpdCBpcC4uLi4=
HMAC_KEY_NOTIFY_ADDRESS=ZHJpcG5lcGFsIHRlc3QgaG1hYyBub3RpZnkuLi4uLi4=
# No CSP report endpoint in tests, whatever .env says (docs/07 §7.3)
CSP_REPORT_URI=
