# Development values for every variable of start/env_schema.ts (docs/09 §6.1,
# §6.4). Copy to .env. No value here is a real secret: the keys below are
# readable placeholders for a developer machine only. T-ARCH-023 checks that
# this file lists exactly the schema's keys.

# Node
NODE_ENV=development
APP_ENV=development
TZ=UTC
PORT=3333
HOST=localhost
# trace, debug, info, warn, error, fatal or silent
LOG_LEVEL=info

# App
APP_NAME=dripnepal
# Generate with: node ace generate:key
APP_KEY=
# Set only for the 7 days of a yearly key rotation (docs/07 §5.5)
APP_KEY_PREVIOUS=
APP_URL=http://${HOST}:${PORT}
# The running release (git commit); the image build sets it
APP_RELEASE=

# How customers reach the store, shared with every page (config/storefront.ts).
# The phone number also becomes a WhatsApp link. Unset ones are hidden.
SUPPORT_PHONE=
SUPPORT_EMAIL=
INSTAGRAM_URL=
FACEBOOK_URL=
TIKTOK_URL=

# Proxies allowed to set X-Forwarded-For: comma-separated CIDRs (docs/11 §3.4)
TRUSTED_PROXY_CIDRS=

# Session: database or memory
SESSION_DRIVER=database

# Database (matches docker-compose.yml, which reads DB_PASSWORD from here).
# The test roles use the same password, so keep `secret` unless you also change
# it in docker/postgres/init/00_create_roles.sql and DB_MIGRATOR_PASSWORD in
# .env.test (tests connect as dripnepal_app with this DB_PASSWORD).
DB_HOST=localhost
DB_PORT=5432
DB_USER=dripnepal
DB_PASSWORD=secret
DB_DATABASE=dripnepal_dev
# For tests only (.env.test)
DB_MIGRATOR_USER=
DB_MIGRATOR_PASSWORD=
# TLS to PostgreSQL: production requires true; DB_SSL_CA is the provider's PEM
DB_SSL=false
DB_SSL_CA=
DB_POOL_MAX=8
# Log each query's SQL, never its bindings (docs/09 §7.6); refused in staging and prod
DB_DEBUG=false

# Uploaded files ("fs" = ./storage on local disk)
DRIVE_DISK=fs

# Rate limiter store: database or memory
LIMITER_STORE=database

# Keys of docs/07 §5.5: base64 of exactly 32 bytes each. Real environments
# generate each with: openssl rand -base64 32
# The field-encryption key ring is <id>:<key>[,<id>:<key>]; the active ID encrypts.
DATA_ENCRYPTION_KEYS=dev1:ZHJpcG5lcGFsIGRldiByaW5nIDEuLi4uLi4uLi4uLi4=
DATA_ENCRYPTION_ACTIVE_KEY_ID=dev1
BLIND_INDEX_KEY=ZHJpcG5lcGFsIGRldiBibGluZCBpbmRleC4uLi4uLi4=
HMAC_KEY_LIMITER=ZHJpcG5lcGFsIGRldiBobWFjIGxpbWl0ZXIuLi4uLi4=
HMAC_KEY_AUDIT_IP=ZHJpcG5lcGFsIGRldiBobWFjIGF1ZGl0IGlwLi4uLi4=
HMAC_KEY_NOTIFY_ADDRESS=ZHJpcG5lcGFsIGRldiBobWFjIG5vdGlmeS4uLi4uLi4=
# The error tracker: unset in development (docs/09 §5.6)
HMAC_KEY_TELEMETRY=
SENTRY_DSN=
# Where browsers report CSP violations: the tracker project's security endpoint (docs/11 §9.6)
CSP_REPORT_URI=

# Courier callbacks (docs/04a §9.14): <id>:<key> ring of 32-byte keys and the active ID;
# required in production. Nepal Can Move hosts per account environment (https only).
COURIER_CALLBACK_KEYS=dev1:ZHJpcG5lcGFsIGRldiBjYWxsYmFjayByaW5nIDEuLi4=
COURIER_CALLBACK_ACTIVE_KEY_ID=dev1
COURIER_NCM_SANDBOX_URL=
COURIER_NCM_PRODUCTION_URL=

# Client (Vite reads VITE_* at build time; never a secret)
VITE_APP_NAME="Drip Nepal"
