# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=database

# Uploaded files ("fs" = ./storage on local disk)
DRIVE_DISK=fs

# Database (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=dripnepal
DB_PASSWORD=secret
DB_DATABASE=dripnepal
# DB_MIGRATOR_USER and DB_MIGRATOR_PASSWORD are for tests only (.env.test)

# Client
VITE_APP_NAME="Drip Nepal"
LIMITER_STORE=database

# Outgoing email (config/mail.ts). Locally it goes to Mailpit (docker compose up -d),
# which shows it at http://localhost:8025. No code sends email yet: the flows
# rebuilt from M1 add it (docs/12).
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Drip Nepal <orders@dripnepal.localhost>"
# SMTP_USERNAME=
# SMTP_PASSWORD=


# How customers reach the store, shared with every page (config/storefront.ts).
# The phone number also becomes a WhatsApp link. Unset ones are hidden.
SUPPORT_PHONE=
SUPPORT_EMAIL=
# INSTAGRAM_URL=https://instagram.com/your-shop
# FACEBOOK_URL=https://facebook.com/your-shop
# TIKTOK_URL=https://tiktok.com/@your-shop
