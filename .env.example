# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=database

# Uploaded product photos ("fs" = ./storage on local disk)
DRIVE_DISK=fs

# Database (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=dripnepal
DB_PASSWORD=secret
DB_DATABASE=dripnepal

# Client
VITE_APP_NAME="Drip Nepal"
LIMITER_STORE=database

# New-order emails to the shop. Locally they go to Mailpit (docker compose up -d),
# which shows them at http://localhost:8025. Leave SMTP_HOST or MAIL_FROM empty
# to turn them off; the dashboard's order count works either way.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Drip Nepal <orders@dripnepal.localhost>"
# SMTP_USERNAME=
# SMTP_PASSWORD=

# One seller in v1; set to true to try shop registration locally
SHOP_REGISTRATION_OPEN=false

# How customers reach you (footer, order pages, policies, "Forgot password?").
# The phone number also becomes a WhatsApp link. Unset ones are hidden.
SUPPORT_PHONE=
SUPPORT_EMAIL=
# INSTAGRAM_URL=https://instagram.com/your-shop
# FACEBOOK_URL=https://facebook.com/your-shop
# TIKTOK_URL=https://tiktok.com/@your-shop
