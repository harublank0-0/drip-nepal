# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=database

# Uploaded product photos ("fs" = ./storage on local disk)
DRIVE_DISK=fs

# Database (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=dripnepal
DB_PASSWORD=secret
DB_DATABASE=dripnepal

# Client
VITE_APP_NAME="Drip Nepal"
LIMITER_STORE=database