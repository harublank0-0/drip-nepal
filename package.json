{
  "name": "drip-nepal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint . --max-warnings 0",
    "lint:arch": "depcruise app start database --config .dependency-cruiser.cjs && node scripts/check_owner_writes.mjs",
    "lint:openapi": "redocly lint docs/openapi.yaml",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
    "prepare": "husky"
  },
  "imports": {
    "#constants/*": "./app/constants/*.js",
    "#utils/*": "./app/utils/*.js",
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#shared/*": "./shared/*.js",
    "#modules/*": "./app/modules/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@redocly/cli": "2.77.0",
    "@secretlint/node": "13.1.0",
    "@secretlint/secretlint-rule-pattern": "13.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@tanstack/react-devtools": "^0.10.8",
    "@tanstack/react-form-devtools": "^0.2.29",
    "@types/luxon": "^3.7.1",
    "@types/node": "~25.9.1",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "^10.4.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hot-hook": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.61.1",
    "prettier": "^3.8.3",
    "secretlint": "13.1.0",
    "shadcn": "^4.8.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "yaml": "2.9.1",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.7.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/inertia": "^5.0.5",
    "@adonisjs/limiter": "3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.1",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.4",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@fontsource-variable/lora": "^5.2.8",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@inertiajs/react": "^3.11.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-form": "^1.33.0",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "edge.js": "^6.5.1",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "framer-motion": "^12.41.0",
    "intl-messageformat": "^12.1.5",
    "lucide-react": "^1.17.0",
    "luxon": "^3.7.2",
    "pg": "^8.21.0",
    "pg-boss": "12.38.0",
    "proxy-addr": "2.0.8",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "reflect-metadata": "^0.2.2",
    "slugify": "^1.6.9",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "prettier": "@adonisjs/prettier-config",
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "database/migrations/*.ts": [
      "node scripts/check_migrations_lock.mjs"
    ],
    "*": [
      "node scripts/scan_secrets.mjs"
    ]
  }
}
