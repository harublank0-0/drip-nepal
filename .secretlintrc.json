{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "DripNepal secret variable with a value (docs/09 §6.1)",
            "patterns": [
              "/^[ \\t]*(?:export[ \\t]+)?(?<name>APP_KEY|APP_KEY_PREVIOUS|DB_PASSWORD|DB_MIGRATOR_PASSWORD|SMTP_PASSWORD|DATA_ENCRYPTION_KEYS|BLIND_INDEX_KEY|HMAC_KEY_[A-Z0-9_]+|SENTRY_DSN)[ \\t]*=[ \\t]*['\"]?(?!(?:the-|change-me|your-|<|\\$))(?<value>[^\\s'\"#]+)/m"
            ]
          }
        ]
      }
    }
  ]
}
