{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "DripNepal secret variable with a value (docs/09 §6.1: names with SECRET or PASSWORD, ending in _KEY or _KEYS, HMAC_KEY_*, APP_KEY_PREVIOUS, SENTRY_DSN)",
            "patterns": [
              "/^[ \\t]*(?:export[ \\t]+)?(?<name>[A-Z0-9_]*(?:SECRET|PASSWORD)[A-Z0-9_]*|[A-Z0-9_]*_KEYS?|APP_KEY_PREVIOUS|HMAC_KEY_[A-Z0-9_]+|SENTRY_DSN)[ \\t]*=[ \\t]*['\"]?(?!(?:the-|change-me|your-|<|\\$))(?<value>[^\\s'\"#]+)/m"
            ]
          }
        ]
      }
    }
  ]
}
