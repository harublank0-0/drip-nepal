storage


# TypeScript incremental build info
*.tsbuildinfo

# Agent skills: only the reviewed ones are tracked (docs/09 §1.5). The
# project's own skills and the vendored copies listed in skills-lock.json are
# committed; any other skill installed locally stays untracked.
.agents/skills/*
!.agents/skills/dripnepal-*/
!.agents/skills/shadcn/
!.agents/skills/vercel-react-best-practices/
!.agents/skills/ncm-integration/

# Claude Code agent worktrees: temporary full copies of the repository
.claude/worktrees/
