{
  "extends": "@adonisjs/tsconfig/tsconfig.client.json",
  "compilerOptions": {
    "module": "ESNext",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "~/*": ["./*"],
      "@generated/*": ["../.adonisjs/client/*"],
      "@shared/*": ["../shared/*"],
      "@lang/*": ["../resources/lang/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../.adonisjs/client/**/*.ts",
    "../.adonisjs/server/**/*.ts",
    "../app/modules/*/events.ts",
    "../types/**/*.d.ts"
  ]
}
